# --- Required ---

# Postgres connection string.
# Neon (neon.tech) has a genuinely free, persistent tier — create a project
# and paste its connection string here. Render, Supabase and Fly also work.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string. Used to sign voter cookies so votes can't be forged,
# and to derive the admin session cookie. REQUIRED in production: with
# NODE_ENV=production and no value here the server refuses to boot, rather
# than falling back to a secret that is public in this repo.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# The password for /admin. Same generator as above works fine.
ADMIN_KEY=replace-me-too


# --- Optional ---

# Public origin, used to build share links and OG tags. No trailing slash.
SITE_ORIGIN=https://canyoutrumpthetrump.com

# Set to "false" to let submissions go live instantly with no review queue.
# Leave true until you know what people send you.
REQUIRE_APPROVAL=true

# How to treat the database's TLS certificate:
#   verify     check it against the public CAs. The correct setting, and what
#              Neon, Supabase and Fly all support.
#   no-verify  encrypt but don't authenticate. The connection can't be read in
#              transit, but nothing proves the far end is really your database.
#   disable    no TLS at all. Local sockets only.
# Defaults to no-verify (and to disable for a localhost URL), which is how this
# app behaved before the setting existed. Move to verify once you've confirmed
# your provider's chain resolves — on managed Postgres it nearly always does.
DATABASE_SSL=verify

PORT=3000
